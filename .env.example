# demo | gemini | vertex. Demo is explicitly labelled and needs no credentials.
AI_PROVIDER=demo
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# For Vertex AI with a service account JSON, keep the file outside git:
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Set GEMINI_MODEL to a model available in your Vertex project/location.
SEARCH_BACKEND=sqlite
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rulelab-clauses
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CA_CERT=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RULELAB_DB=data/rulelab.sqlite3
# Optional bearer token for all /api/* except health. Useful before remote hosting.
RULELAB_API_TOKEN=

# Single workspace deployment controls. Production refuses startup without named keys + HTTPS origins.
RULELAB_DEPLOYMENT_MODE=development
RULELAB_ACCESS_KEYS=[]
RULELAB_ALLOWED_ORIGINS=
RULELAB_MAX_AGENT_JOBS=4
RULELAB_AGENT_STEP_TIMEOUT=180

# Embedding requests can use a separate regional endpoint.
EMBEDDING_LOCATION=us-central1
RULELAB_AI_TIMEOUT=90
RULELAB_AI_CONCURRENCY=5
